<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Fluent Black / Dark Palette -->
    <SolidColorBrush x:Key="BgPrimaryBrush" Color="#080A0F"/>
    <SolidColorBrush x:Key="BgSecondaryBrush" Color="#0F131C"/>
    <SolidColorBrush x:Key="BgCardBrush" Color="#131926"/>
    <SolidColorBrush x:Key="BgSidebarBrush" Color="#0C1018"/>
    <SolidColorBrush x:Key="BgHoverBrush" Color="#1A2233"/>
    <SolidColorBrush x:Key="BgSelectedBrush" Color="#172A4A"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#1D2433"/>
    <SolidColorBrush x:Key="BorderLightBrush" Color="#2D374B"/>

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#94A3B8"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#64748B"/>

    <SolidColorBrush x:Key="AccentBlueBrush" Color="#3B82F6"/>
    <SolidColorBrush x:Key="AccentGreenBrush" Color="#10B981"/>
    <SolidColorBrush x:Key="AccentRedBrush" Color="#EF4444"/>
    <SolidColorBrush x:Key="AccentAmberBrush" Color="#F59E0B"/>

    <SolidColorBrush x:Key="GridRowBrush" Color="#0B0F17"/>
    <SolidColorBrush x:Key="GridAltRowBrush" Color="#0F141F"/>
    <SolidColorBrush x:Key="GridLineBrush" Color="#172030"/>
    <SolidColorBrush x:Key="GridSelectedRowBrush" Color="#1D3557"/>
    <SolidColorBrush x:Key="GridSelectedTextBrush" Color="#FFFFFF"/>

    <SolidColorBrush x:Key="DangerBgBrush" Color="#2A1215"/>
    <SolidColorBrush x:Key="DangerTextBrush" Color="#F87171"/>
    <SolidColorBrush x:Key="DangerBorderBrush" Color="#7F1D1D"/>

    <SolidColorBrush x:Key="NavSelectedTextBrush" Color="#FFFFFF"/>

</ResourceDictionary>
