<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Minimalist / Raycast Palette -->
    <SolidColorBrush x:Key="BgPrimaryBrush" Color="#101012"/>
    <SolidColorBrush x:Key="BgSecondaryBrush" Color="#16161A"/>
    <SolidColorBrush x:Key="BgCardBrush" Color="#1A1A1F"/>
    <SolidColorBrush x:Key="BgSidebarBrush" Color="#131316"/>
    <SolidColorBrush x:Key="BgHoverBrush" Color="#23232A"/>
    <SolidColorBrush x:Key="BgSelectedBrush" Color="#2B2942"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#27272E"/>
    <SolidColorBrush x:Key="BorderLightBrush" Color="#383842"/>

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F4F4F5"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A1A1AA"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#71717A"/>

    <SolidColorBrush x:Key="AccentBlueBrush" Color="#6366F1"/>
    <SolidColorBrush x:Key="AccentGreenBrush" Color="#22C55E"/>
    <SolidColorBrush x:Key="AccentRedBrush" Color="#F43F5E"/>
    <SolidColorBrush x:Key="AccentAmberBrush" Color="#F59E0B"/>

    <SolidColorBrush x:Key="GridRowBrush" Color="#131317"/>
    <SolidColorBrush x:Key="GridAltRowBrush" Color="#16161B"/>
    <SolidColorBrush x:Key="GridLineBrush" Color="#222228"/>
    <SolidColorBrush x:Key="GridSelectedRowBrush" Color="#2B2942"/>
    <SolidColorBrush x:Key="GridSelectedTextBrush" Color="#FFFFFF"/>

    <SolidColorBrush x:Key="DangerBgBrush" Color="#2B141B"/>
    <SolidColorBrush x:Key="DangerTextBrush" Color="#FB7185"/>
    <SolidColorBrush x:Key="DangerBorderBrush" Color="#881337"/>

    <SolidColorBrush x:Key="NavSelectedTextBrush" Color="#E0E7FF"/>

</ResourceDictionary>
