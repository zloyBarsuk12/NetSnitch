<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Fluent Light Palette -->
    <SolidColorBrush x:Key="BgPrimaryBrush" Color="#F3F5F9"/>
    <SolidColorBrush x:Key="BgSecondaryBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BgCardBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BgSidebarBrush" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="BgHoverBrush" Color="#EEF2F7"/>
    <SolidColorBrush x:Key="BgSelectedBrush" Color="#DBEAFE"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="BorderLightBrush" Color="#CBD5E1"/>

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#0F172A"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#475569"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#94A3B8"/>

    <SolidColorBrush x:Key="AccentBlueBrush" Color="#2563EB"/>
    <SolidColorBrush x:Key="AccentGreenBrush" Color="#059669"/>
    <SolidColorBrush x:Key="AccentRedBrush" Color="#DC2626"/>
    <SolidColorBrush x:Key="AccentAmberBrush" Color="#D97706"/>

    <SolidColorBrush x:Key="GridRowBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="GridAltRowBrush" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="GridLineBrush" Color="#F1F5F9"/>
    <SolidColorBrush x:Key="GridSelectedRowBrush" Color="#DBEAFE"/>
    <SolidColorBrush x:Key="GridSelectedTextBrush" Color="#1E3A8A"/>

    <SolidColorBrush x:Key="DangerBgBrush" Color="#FEE2E2"/>
    <SolidColorBrush x:Key="DangerTextBrush" Color="#B91C1C"/>
    <SolidColorBrush x:Key="DangerBorderBrush" Color="#FCA5A5"/>

    <SolidColorBrush x:Key="NavSelectedTextBrush" Color="#1D4ED8"/>

</ResourceDictionary>
