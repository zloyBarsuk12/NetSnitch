<Window x:Class="NetSnitch.ArdViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NetSnitch ARD / Screen Sharing Viewer"
        Icon="pack://application:,,,/Assets/NetSnitch.ico"
        Height="760" Width="1180"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgPrimaryBrush}"
        KeyDown="Window_KeyDown" KeyUp="Window_KeyUp">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Connection Toolbar -->
        <Border Grid.Row="0" Background="{StaticResource BgSecondaryBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="🍎 ARD / VNC:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox x:Name="HostBox" Width="140" Margin="0,0,6,0" ToolTip="IP или хост Mac"/>
                <TextBox x:Name="PortBox" Width="60" Text="5900" Margin="0,0,8,0" ToolTip="Порт (по умолчанию 5900)"/>
                <TextBlock Text="Логин:" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <TextBox x:Name="UserBox" Width="115" Margin="0,0,8,0" ToolTip="Логин macOS (для Apple ARD; пусто для VNC-пароля)"/>
                <TextBlock Text="Пароль:" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <PasswordBox x:Name="PassBox" Width="125" Background="{StaticResource BgPrimaryBrush}" Foreground="{StaticResource TextPrimaryBrush}"
                             BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" Padding="6,4" Margin="0,0,10,0"/>
                <Button x:Name="ConnectBtn" Content="▶ Подключиться" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,10,0" Click="ConnectBtn_Click"/>
                <TextBlock x:Name="StatusText" Text="Введите логин/пароль Mac и нажмите Подключиться" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
            </StackPanel>
        </Border>

        <!-- Remote Screen -->
        <Border Grid.Row="1" Background="#05080F" ClipToBounds="True">
            <Viewbox Stretch="Uniform">
                <Image x:Name="ScreenImage" Stretch="None"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       MouseMove="ScreenImage_MouseMove"
                       MouseDown="ScreenImage_MouseDown"
                       MouseUp="ScreenImage_MouseUp"
                       MouseWheel="ScreenImage_MouseWheel"/>
            </Viewbox>
        </Border>
    </Grid>
</Window>
