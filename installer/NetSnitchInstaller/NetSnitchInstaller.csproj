<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>NetSnitchSetup</AssemblyName>
    <ApplicationIcon>..\..\Assets\NetSnitch.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="payload.zip" />
    <Resource Include="..\..\Assets\NetSnitch.ico" Link="NetSnitch.ico" />
  </ItemGroup>
</Project>
