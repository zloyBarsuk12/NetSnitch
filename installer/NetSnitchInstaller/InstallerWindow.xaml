<Window x:Class="NetSnitchInstaller.InstallerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Установка NetSnitch Combine v1.5.0"
        Icon="pack://application:,,,/NetSnitch.ico"
        Height="430" Width="560" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#0B0F17" Foreground="#F1F5F9" FontFamily="Segoe UI">

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,18">
            <Image Source="pack://application:,,,/NetSnitch.ico" Width="44" Height="44" Margin="0,0,14,0"/>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" Text="NetSnitch Combine" FontSize="19" FontWeight="Bold" Foreground="#FFFFFF"/>
                <TextBlock x:Name="SubtitleText" Text="Версия 1.5.0 • Мастер установки" FontSize="12" Foreground="#94A3B8"/>
            </StackPanel>
        </StackPanel>

        <!-- Body -->
        <Border Grid.Row="1" Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="8" Padding="16">
            <StackPanel x:Name="InstallOptionsPanel">
                <TextBlock Text="Папка установки:" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,6"/>
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="InstallPathBox" Grid.Column="0" Background="#0B0F17" Foreground="#F1F5F9"
                             BorderBrush="#334155" BorderThickness="1" Padding="8,6" FontSize="12"/>
                    <Button x:Name="BrowseBtn" Grid.Column="1" Content="Обзор..." Margin="8,0,0,0" Padding="12,6"
                            Background="#1E293B" Foreground="#F1F5F9" BorderBrush="#334155" Cursor="Hand"
                            Click="BrowseBtn_Click"/>
                </Grid>

                <CheckBox x:Name="DesktopShortcutCheck" Content="Создать ярлык на Рабочем столе" IsChecked="True"
                          Foreground="#E2E8F0" FontSize="13" Margin="0,0,0,8"/>
                <CheckBox x:Name="StartMenuShortcutCheck" Content="Создать ярлык в меню «Пуск»" IsChecked="True"
                          Foreground="#E2E8F0" FontSize="13" Margin="0,0,0,8"/>
                <CheckBox x:Name="LaunchAfterCheck" Content="Запустить NetSnitch Combine после установки" IsChecked="True"
                          Foreground="#E2E8F0" FontSize="13" Margin="0,0,0,4"/>
            </StackPanel>
        </Border>

        <!-- Progress -->
        <StackPanel Grid.Row="2" Margin="0,14,0,14">
            <TextBlock x:Name="StatusText" Text="Готов к установке" FontSize="12" Foreground="#94A3B8" Margin="0,0,0,6"/>
            <ProgressBar x:Name="InstallProgress" Height="8" Minimum="0" Maximum="100" Value="0"
                         Background="#1E293B" Foreground="#3B82F6" BorderThickness="0"/>
        </StackPanel>

        <!-- Footer Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CancelBtn" Content="Отмена" Padding="16,8" Margin="0,0,8,0"
                    Background="#1E293B" Foreground="#CBD5E1" BorderBrush="#334155" Cursor="Hand"
                    Click="CancelBtn_Click"/>
            <Button x:Name="ActionBtn" Content="Установить" Padding="20,8" FontWeight="SemiBold"
                    Background="#2563EB" Foreground="#FFFFFF" BorderBrush="#3B82F6" Cursor="Hand"
                    Click="ActionBtn_Click"/>
        </StackPanel>
    </Grid>
</Window>
