<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>NetSnitch</AssemblyName>
    <RootNamespace>NetSnitch</RootNamespace>
    <Version>1.1.1</Version>
    <AssemblyVersion>1.1.1.0</AssemblyVersion>
    <FileVersion>1.1.1.0</FileVersion>
    <Product>NetSnitch Combine</Product>
    <Description>All-in-One Windows Network Monitor, Subnet/Port Scanner, Dig, MTR, WHOIS, TLS/HTTP Inspector &amp; Firewall Manager</Description>
    <ApplicationIcon>Assets\NetSnitch.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\NetSnitch.ico" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="installer\**" />
    <Page Remove="installer\**" />
    <None Remove="installer\**" />
  </ItemGroup>

</Project>
